// GENERATED FILE - DO NOT EDIT.
// Source: .agents/skills/firestore-rules-manager/docs/*.md (rebuild with `npm run rules:build`).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ==========================================
    // FUNKCJE POMOCNICZE DLA GRUP
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // User-owned documents (`userId` field), see "Pattern: user-owned documents"
    function isOwner(data) {
      return isAuthenticated() && data.userId == request.auth.uid;
    }

    // Update whitelist: only the listed fields may differ from the stored document
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Returns null for non-members: a missing member doc must not raise an evaluation
    // error, otherwise it fails the whole `||` chain of the rule that calls it.
    function getRole(groupId) {
      let member = get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      return member != null ? member.data.role : null;
    }

    function isAdminOrOwner(groupId) {
      let role = getRole(groupId);
      return role == 'admin' || role == 'owner';
    }

    function getRolePriority(role) {
      return role == 'owner' ? 4 : (role == 'admin' ? 3 : (role == 'moderator' ? 2 : 1));
    }

    function hasHigherPriority(groupId, targetUserId, newRole) {
      let callerPriority = getRolePriority(getRole(groupId));
      let targetDoc = get(/databases/$(database)/documents/groups/$(groupId)/members/$(targetUserId));
      let targetPriority = targetDoc != null ? getRolePriority(targetDoc.data.role) : 0;

      let assignPriority = newRole != null ? getRolePriority(newRole) : 0;

      return callerPriority > targetPriority && callerPriority > assignPriority;
    }

    function hasRolePermission(groupId, permission) {
      let role = getRole(groupId);
      return role != null && roleHasPermission(groupId, role, permission);
    }

    function roleHasPermission(groupId, role, permission) {
      let groupData = get(/databases/$(database)/documents/groups/$(groupId)).data;
      let customPerm = groupData.get(['rolePermissions', role, permission], null);
      return role == 'owner' || (
        customPerm != null ? customPerm == true : (
          permission == 'editGroup' ? false : (
            role == 'admin' ? true : (
              role == 'moderator' ? (permission == 'inviteMembers') : false
            )
          )
        )
      );
    }

    // ==========================================
    // COLLECTION GROUP: ZAPYTANIA O CZŁONKOSTWA I ZAPROSZENIA
    // ==========================================
    match /{path=**}/members/{memberDocId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /{path=**}/invitations/{invDocId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // WYDARZENIA (EVENTS)
    // ==========================================
    match /events/{eventId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants || request.auth.uid == resource.data.creatorId);
      allow create: if isAuthenticated() &&
        request.resource.data.creatorId == request.auth.uid &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.isFinalized == false &&
        request.resource.data.get('votes', {}).keys().hasOnly([request.auth.uid]);
      allow update: if isAuthenticated() && (
        (resource.data.creatorId == request.auth.uid &&
          request.resource.data.creatorId == resource.data.creatorId &&
          (resource.data.get('isFinalized', false) == false ||
            // Finalized (I5): rename / new description, or reopen dropping only slots (and their votes)
            onlyChanges(['name', 'description', 'updatedAt']) ||
            (request.resource.data.isFinalized == false &&
              onlyChanges(['isFinalized', 'finalizedSlotKey', 'proposedDates', 'votes', 'updatedAt']) &&
              resource.data.proposedDates.hasAll(request.resource.data.proposedDates)))) ||
        // Participants vote: only their own entry in `votes` changes, while the event is open
        (resource.data.get('isFinalized', false) == false &&
          request.auth.uid in resource.data.participants &&
          onlyChanges(['votes', 'updatedAt']) &&
          request.resource.data.get('votes', {}).diff(resource.data.get('votes', {})).affectedKeys().hasOnly([request.auth.uid]))
      );
      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }

    // Reguły dla zaproszeń do znajomych
    match /friendRequests/{requestId} {
      allow read, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.senderUid ||
        request.auth.uid == resource.data.receiverUid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.receiverUid != request.auth.uid &&
        requestId == request.auth.uid + '_' + request.resource.data.receiverUid &&
        request.resource.data.status == 'pending';
    }

    // ==========================================
    // GRUPY (KOLEKCJA GŁÓWNA)
    // ==========================================
    match /groups/{groupId} {
      allow read: if isAuthenticated() && (
        resource.data.type == 'public' ||
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/groups/$(groupId)/invitations/$(request.auth.uid))
      );

      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;

      allow update: if isAuthenticated() && (
        getRole(groupId) == 'owner' || (
          hasRolePermission(groupId, 'editGroup') &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.get('rolePermissions', null) == resource.data.get('rolePermissions', null)
        )
      );
      allow delete: if isAuthenticated() && getRole(groupId) == 'owner';

      // ------------------------------------------
      // PODKOLEKCJA: CZŁONKOWIE (MEMBERS)
      // ------------------------------------------
      match /members/{userId} {
        allow read: if isAuthenticated() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));

        allow create: if isAuthenticated() &&
          request.resource.data.keys().hasOnly(['userId', 'role', 'joinedAt']) &&
          request.resource.data.userId == userId && (
            // Owner bootstrap in createGroup (same batch as the group doc, hence getAfter)
            (userId == request.auth.uid && request.resource.data.role == 'owner' &&
              getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid) ||
            // Every other way in joins as a plain member
            (request.resource.data.role == 'member' && (
              // Accepting a pending join request: the batch also deletes it (exists() sees the state before the batch)
              (hasRolePermission(groupId, 'manageRequests') &&
                exists(/databases/$(database)/documents/groups/$(groupId)/requests/$(userId)) &&
                !existsAfter(/databases/$(database)/documents/groups/$(groupId)/requests/$(userId))) ||
              (userId == request.auth.uid && get(/databases/$(database)/documents/groups/$(groupId)).data.type == 'public' && get(/databases/$(database)/documents/groups/$(groupId)).data.requiresApproval == false) ||
              (userId == request.auth.uid && exists(/databases/$(database)/documents/groups/$(groupId)/invitations/$(request.auth.uid)))
            ))
          );

        allow update: if isAuthenticated() &&
          onlyChanges(['role']) && (
            (hasRolePermission(groupId, 'manageMembers') && hasHigherPriority(groupId, userId, request.resource.data.role)) ||
            (getRole(groupId) == 'owner' && request.resource.data.role == 'owner') ||
            (userId == request.auth.uid && getRole(groupId) == 'owner' && request.resource.data.role == 'admin')
          );

        allow delete: if isAuthenticated() && (
          // The owner leaves only together with the group (deleteGroup batch)
          (userId == request.auth.uid && (
            getRole(groupId) != 'owner' ||
            !existsAfter(/databases/$(database)/documents/groups/$(groupId))
          )) ||
          (hasRolePermission(groupId, 'manageMembers') && hasHigherPriority(groupId, userId, null))
        );
      }

      // ------------------------------------------
      // PODKOLEKCJA: ZAPROSZENIA DO GRUPY (INVITATIONS)
      // ------------------------------------------
      match /invitations/{userId} {
        allow read: if isAuthenticated() && (
          userId == request.auth.uid ||
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
        );
        allow create, update: if isAuthenticated() &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
          hasRolePermission(groupId, 'inviteMembers');
        allow delete: if isAuthenticated() && (
          userId == request.auth.uid ||
          hasRolePermission(groupId, 'inviteMembers')
        );
      }

      // ------------------------------------------
      // PODKOLEKCJA: PROŚBY O DOŁĄCZENIE (REQUESTS)
      // ------------------------------------------
      match /requests/{userId} {
        allow read: if isAuthenticated() && (userId == request.auth.uid || hasRolePermission(groupId, 'manageRequests'));
        allow create: if isAuthenticated() && userId == request.auth.uid;
        allow delete: if isAuthenticated() && (userId == request.auth.uid || hasRolePermission(groupId, 'manageRequests'));
      }
    }

    // ==========================================
    // LOOKUP KOLORY (LOOKUP COLORS)
    // ==========================================
    match /lookup_colors/{colorId} {
      allow read, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data);
      allow update: if isOwner(resource.data) && isOwner(request.resource.data);
    }

    // ==========================================
    // LOOKUP MATERIAŁY (LOOKUP MATERIALS)
    // ==========================================
    match /lookup_materials/{materialId} {
      allow read, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data);
      allow update: if isOwner(resource.data) && isOwner(request.resource.data);
    }

    // ==========================================
    // LOOKUP TYPY (LOOKUP TYPES)
    // ==========================================
    match /lookup_types/{typeId} {
      allow read, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data);
      allow update: if isOwner(resource.data) && isOwner(request.resource.data);
    }

    // ==========================================
    // GRUPY ROZLICZENIOWE (SPLIT GROUPS)
    // ==========================================
    match /split_groups/{groupId} {
      function splitGroupPath() {
        return /databases/$(database)/documents/split_groups/$(groupId);
      }

      function isSplitGroupParticipant() {
        return request.auth.uid in get(splitGroupPath()).data.participants;
      }

      function isSplitGroupOwner() {
        return get(splitGroupPath()).data.createdBy == request.auth.uid;
      }

      function isSplitGroupDeleting() {
        return get(splitGroupPath()).data.get('status', 'active') == 'deleting';
      }

      function splitGroupCounterChangedBy(field, delta) {
        return getAfter(splitGroupPath()).data[field] == get(splitGroupPath()).data[field] + delta;
      }

      function splitGroupTouchedInSameWrite() {
        return getAfter(splitGroupPath()).data.get('updatedAt', 0) != get(splitGroupPath()).data.get('updatedAt', 0);
      }

      function splitGroupParticipantsChangeAllowed() {
        let before = resource.data.participants;
        let after = request.resource.data.participants;
        let withoutSelf = before.removeAll([request.auth.uid]);
        return after.hasAll(before) ||
          (resource.data.createdBy == request.auth.uid && before.hasAll(after) &&
            after.size() == before.size() - 1 && resource.data.createdBy in after) ||
          (request.auth.uid != resource.data.createdBy && after.hasAll(withoutSelf) && withoutSelf.hasAll(after));
      }

      function splitGroupSettledBeforeDeleting() {
        return request.resource.data.get('status', 'active') != 'deleting' ||
          resource.data.get('status', 'active') == 'deleting' ||
          (request.resource.data.get('simplifyDebts', false)
            ? request.resource.data.balances.size() == 0
            : request.resource.data.pairBalances.size() == 0);
      }

      function splitGroupOwnerFieldsUnchanged() {
        return request.resource.data.name == resource.data.name &&
          request.resource.data.description == resource.data.description &&
          request.resource.data.defaultCurrency == resource.data.defaultCurrency &&
          request.resource.data.get('status', 'active') == resource.data.get('status', 'active');
      }

      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.expensesCount == 0 &&
        request.resource.data.settlementsCount == 0 &&
        request.resource.data.totalSpent == {} &&
        request.resource.data.status == 'active' &&
        request.resource.data.get('version', 0) == 0;
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.get('version', 0) >= resource.data.get('version', 0) &&
        splitGroupParticipantsChangeAllowed() &&
        splitGroupSettledBeforeDeleting() &&
        (resource.data.createdBy == request.auth.uid || splitGroupOwnerFieldsUnchanged());
      allow delete: if isAuthenticated() &&
        resource.data.createdBy == request.auth.uid &&
        resource.data.get('status', 'active') == 'deleting';

      // ------------------------------------------
      // PODKOLEKCJA: WYDATKI (EXPENSES)
      // ------------------------------------------
      match /expenses/{expenseId} {
        allow read: if isAuthenticated() && isSplitGroupParticipant();
        allow create: if isAuthenticated() && isSplitGroupParticipant() &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.groupId == groupId &&
          splitGroupCounterChangedBy('expensesCount', 1);
        allow update: if isAuthenticated() && isSplitGroupParticipant() &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.groupId == resource.data.groupId &&
          // The author edits; anyone converts the group currency (money fields only)
          (resource.data.createdBy == request.auth.uid || onlyChanges(['currency', 'amount', 'splits', 'conversion'])) &&
          splitGroupCounterChangedBy('expensesCount', 0) &&
          splitGroupTouchedInSameWrite();
        allow delete: if isAuthenticated() && isSplitGroupParticipant() && (
          (resource.data.createdBy == request.auth.uid && splitGroupCounterChangedBy('expensesCount', -1)) ||
          (isSplitGroupDeleting() && isSplitGroupOwner())
        );
      }

      // ------------------------------------------
      // PODKOLEKCJA: SPŁATY (SETTLEMENTS)
      // ------------------------------------------
      match /settlements/{settlementId} {
        allow read: if isAuthenticated() && isSplitGroupParticipant();
        allow create: if isAuthenticated() && isSplitGroupParticipant() &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.groupId == groupId &&
          splitGroupCounterChangedBy('settlementsCount', 1);
        allow update: if isAuthenticated() && isSplitGroupParticipant() &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.groupId == resource.data.groupId && (
            // The receiver confirms a pending settlement
            (resource.data.receiverId == request.auth.uid &&
              resource.data.get('status', 'confirmed') == 'pending' &&
              request.resource.data.status == 'confirmed' &&
              onlyChanges(['status'])) ||
            // Anyone converts the group currency (money fields only)
            onlyChanges(['currency', 'amount', 'conversion'])
          ) &&
          splitGroupCounterChangedBy('settlementsCount', 0) &&
          splitGroupTouchedInSameWrite();
        allow delete: if isAuthenticated() && isSplitGroupParticipant() && (
          ((resource.data.payerId == request.auth.uid || resource.data.receiverId == request.auth.uid) &&
            splitGroupCounterChangedBy('settlementsCount', -1)) ||
          (isSplitGroupDeleting() && isSplitGroupOwner())
        );
      }
    }

    // ==========================================
    // SZPULE FILAMENTU (SPOOLS)
    // ==========================================
    match /spools/{spoolId} {
      allow read, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data);
      allow update: if isOwner(resource.data) && isOwner(request.resource.data);

      // Podkolekcja historii wydruków
      match /prints/{printId} {
        allow read, write: if isAuthenticated() &&
          get(/databases/$(database)/documents/spools/$(spoolId)).data.userId == request.auth.uid;
      }
    }

    // ==========================================
    // SZABLONY FILAMENTU (TEMPLATES)
    // ==========================================
    match /templates/{templateId} {
      allow read, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data);
      allow update: if isOwner(resource.data) && isOwner(request.resource.data);
    }

    // Kolekcja nazw użytkowników (do weryfikacji unikalności)
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['uid']) &&
        request.resource.data.uid == request.auth.uid;
      // Re-saving your own reservation is a no-op; taking over someone else's is an update and is denied
      allow update: if isAuthenticated() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid']) &&
        request.resource.data.uid == request.auth.uid;
      // I4: the profile must point elsewhere after the batch (or be deleted)
      function isReleasedByProfile(username) {
        let profile = getAfter(/databases/$(database)/documents/users/$(request.auth.uid));
        return profile == null || profile.data.get('usernameLower', '') != username;
      }

      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid &&
        isReleasedByProfile(username);
    }

    // Reguły dla kolekcji użytkowników
    match /users/{userId} {
      // Profiles are public to signed-in users: only whitelisted, non-private fields (no email)
      function hasAllowedFields() {
        return request.resource.data.keys().hasOnly([
          'uid', 'username', 'usernameLower', 'avatarUrl', 'darkMode', 'language', 'startupWaste'
        ]);
      }

      // I3: the (new) username is reserved by this user after the batch
      function hasOwnUsernameReservation() {
        let reservation = getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower));
        return request.resource.data.usernameLower == request.resource.data.username.lower() &&
          reservation != null && reservation.data.uid == userId;
      }

      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        hasAllowedFields() && hasOwnUsernameReservation();
      allow update: if isAuthenticated() && request.auth.uid == userId &&
        hasAllowedFields() && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['username', 'usernameLower']) ||
          hasOwnUsernameReservation()
        );
      allow delete: if isAuthenticated() && request.auth.uid == userId;

      // Subkolekcja znajomości (friendships)
      match /friendships/{friendId} {
        // `exists()` sees the state before the batch, so the request deleted by acceptFriendRequest still counts
        function hasPendingRequestFrom(otherUid) {
          return exists(/databases/$(database)/documents/friendRequests/$(otherUid + '_' + request.auth.uid));
        }

        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create: if isAuthenticated() &&
          request.resource.data.keys().hasOnly(['userRef', 'createdAt']) && (
            (request.auth.uid == userId && hasPendingRequestFrom(friendId)) ||
            (request.auth.uid == friendId && hasPendingRequestFrom(userId))
          );
        allow delete: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == friendId);
      }

      // Subkolekcja powiadomień (notifications)
      match /notifications/{notifId} {
        // Who resolves the source of this notification (N4): sender, staff of its group, owner of its split group
        function isNotificationResolver() {
          let data = resource.data;
          let splitGroup = data.get('splitGroupId', null) != null
            ? get(/databases/$(database)/documents/split_groups/$(data.splitGroupId))
            : null;
          return data.senderUid == request.auth.uid ||
            (data.get('groupId', null) != null && isAdminOrOwner(data.groupId)) ||
            (splitGroup != null && splitGroup.data.createdBy == request.auth.uid);
        }

        function isValidNotification() {
          return request.resource.data.keys().hasOnly([
            'id', 'type', 'senderUid', 'senderUsername', 'senderAvatarUrl', 'createdAt', 'read',
            'eventId', 'eventName', 'splitGroupId', 'splitGroupName', 'groupId', 'groupName'
          ]) &&
          request.resource.data.id == notifId &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.read == false &&
          request.resource.data.type in [
            'friend_request', 'friend_request_accepted', 'friend_request_rejected', 'group_invitation',
            'group_invitation_accepted', 'group_invitation_rejected', 'group_request_accepted', 'group_request_rejected',
            'group_ownership_transferred', 'group_deleted',
            'event_invitation', 'event_reopened', 'split_group_invitation', 'split_settlement_pending'
          ];
        }

        allow list: if isAuthenticated() && request.auth.uid == userId;
        allow get: if isAuthenticated() && (
          request.auth.uid == userId || resource == null || isNotificationResolver()
        );
        allow create: if isAuthenticated() && isValidNotification();
        allow update: if isAuthenticated() && (
          (request.auth.uid == userId && onlyChanges(['read'])) ||
          ((resource.data.senderUid == request.auth.uid || resource.data.read == true) && isValidNotification())
        );
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          resource == null ||
          (resource.data.read == false && isNotificationResolver())
        );
      }

      // Subkolekcja zaproszeń do grup (groupInvitations)
      match /groupInvitations/{groupId} {
        allow create, update: if isAuthenticated() &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
          hasRolePermission(groupId, 'inviteMembers');
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          hasRolePermission(groupId, 'inviteMembers')
        );
      }
    }
  }
}
