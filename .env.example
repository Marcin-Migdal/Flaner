# =========================================================================
# FLANER V2 - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file as .env and fill in the values (local development uses the DEV project flaner-v2-dev).
# Values: Firebase console → flaner-v2-dev → Project settings → Your apps → Web app config.
# See README.md → "Local setup".
# =========================================================================

# 1. Firebase Configuration (web config, public by design)
VITE_API_KEY=your_api_key
VITE_AUTH_DOMAIN=your_auth_domain
VITE_PROJECT_ID=your_project_id
VITE_STORAGE_BUCKET=your_storage_bucket
VITE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_APP_ID=your_app_id
VITE_MEASUREMENT_ID=your_measurement_id

# 2. Cloudinary Configuration (unsigned upload preset)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# 3. MFE remote URLs (only for the core host on Vercel; locally the host uses localhost:4201-4205)
# VITE_MFE_SETTINGS_URL=https://flaner-settings.vercel.app
# VITE_MFE_COMMUNITY_URL=https://flaner-community.vercel.app
# VITE_MFE_PLANNING_URL=https://flaner-planning.vercel.app
# VITE_MFE_SHOPPING_URL=https://flaner-shopping.vercel.app
# VITE_MFE_TOOLS_URL=https://flaner-tools.vercel.app

# 4. Set automatically by `npm run dev:emulators` and `npm run e2e` — do not set by hand
# VITE_USE_EMULATORS=true
