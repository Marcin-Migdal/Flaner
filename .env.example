# =========================================================================
# FLANER V2 - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file as .env and fill in the values.
# =========================================================================

# 1. Firebase Configuration
VITE_API_KEY=your_api_key
VITE_AUTH_DOMAIN=your_auth_domain
VITE_PROJECT_ID=your_project_id
VITE_STORAGE_BUCKET=your_storage_bucket
VITE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_APP_ID=your_app_id
VITE_MEASUREMENT_ID=your_measurement_id

# 2. Cloudinary Configuration
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# 3. Application Name (displayed in headers)
VITE_APP_NAME=Flaner

# 4. MFE Production URLs (needed only when deploying to Vercel/Firebase)
# VITE_MFE_SETTINGS_URL=https://flaner-settings.vercel.app
# VITE_MFE_COMMUNITY_URL=https://flaner-community.vercel.app
# VITE_MFE_SHOPPING_URL=https://flaner-shopping.vercel.app
# VITE_MFE_SCHEDULING_URL=https://flaner-scheduling.vercel.app
