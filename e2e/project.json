{
  "name": "e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "e2e",
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config=e2e/playwright.config.ts"
      }
    },
    "e2e:community": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config=e2e/playwright.config.ts --project=community"
      }
    },
    "e2e:settings": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config=e2e/playwright.config.ts --project=settings"
      }
    },
    "e2e:core": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config=e2e/playwright.config.ts --project=core"
      }
    },
    "e2e:mobile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config=e2e/playwright.config.ts --project=mobile"
      }
    }
  },
  "implicitDependencies": ["core", "community", "settings", "planning", "shopping", "tools"]
}
