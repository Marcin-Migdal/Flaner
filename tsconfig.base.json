{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "types": ["@testing-library/jest-dom/vitest", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@flaner/shared/*": ["packages/shared/src/*"],
      "@flaner/ui-components": ["packages/ui-components/src/index.ts"],
      "@flaner/ui-components/*": ["packages/ui-components/src/*"],
      "@flaner/test-utils": ["packages/test-utils/src/index.ts"],
      "@flaner/test-utils/*": ["packages/test-utils/src/*"]
    }
  }
}
